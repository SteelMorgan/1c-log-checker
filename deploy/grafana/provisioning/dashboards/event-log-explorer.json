      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {},
          "pluginVersion": "4.11.2",
          "queryType": "table",
          "rawSql": "SELECT\n  event_time AS \"Дата, время\",\n  cluster_name AS \"Кластер\",\n  infobase_name AS \"Информационная база\",\n  level AS \"Уровень\",\n  event_presentation AS \"Событие\",\n  user_name AS \"Пользователь\",\n  computer AS \"Компьютер\",\n  application_presentation AS \"Приложение\",\n  session_id AS \"Сеанс\",\n  connection AS \"Соединение\",\n  transaction_status AS \"Статус транзакции\",\n  transaction_id AS \"ID транзакции\",\n  metadata_presentation AS \"Метаданные\",\n  data_presentation AS \"Данные\",\n  comment AS \"Комментарий\",\n  comment_normalized AS \"Нормализованный комментарий\",\n  server AS \"Сервер\"\nFROM logs.event_log\nWHERE level in (${Level})\n  AND infobase_name in (${Infobase})\n  AND cluster_name in (${Cluster})\n  AND application_presentation in (${Application})\n  AND transaction_status in (${TransactionStatus})\n  AND (empty('${Event}') OR event_presentation LIKE concat('%', '${Event}', '%'))\n  AND (empty('${UserName}') OR user_name LIKE concat('%', '${UserName}', '%'))\n  AND (empty('${Computer}') OR computer LIKE concat('%', '${Computer}', '%'))\n  AND (empty('${SessionId}') OR toString(session_id) LIKE concat('%', '${SessionId}', '%'))\n  AND (empty('${ConnectionId}') OR toString(connection_id) LIKE concat('%', '${ConnectionId}', '%'))\n  AND (empty('${Connection}') OR toString(connection) LIKE concat('%', '${Connection}', '%'))\n  AND (empty('${TransactionId}') OR toString(transaction_id) LIKE concat('%', '${TransactionId}', '%'))\n  AND (empty('${MetadataPresentation}') OR metadata_presentation LIKE concat('%', '${MetadataPresentation}', '%'))\n  AND (empty('${Comment}') OR comment LIKE concat('%', '${Comment}', '%'))\n  AND (empty('${DataPresentation}') OR data_presentation LIKE concat('%', '${DataPresentation}', '%'))\n  AND (empty('${CommentNormalized}') OR comment_normalized LIKE concat('%', '${CommentNormalized}', '%'))\nORDER BY event_time DESC\nLIMIT 1000",
          "refId": "A"
        }
      ],
      "title": "Детальная таблица событий",
      "type": "table"
    }
  ],
