<?xml version="1.0"?>
<clickhouse>
    <users>
        <default>
            <!-- default user: only local and Docker bridge access (no remote) -->
            <no_password/>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
                <ip>172.16.0.0/12</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>
</clickhouse>
