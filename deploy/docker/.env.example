# =============================================================================
# 1c-log-checker — конфигурация окружения
# =============================================================================
# Скопируйте в .env и настройте под своё окружение.
# .env НЕ коммитится в git.

# -----------------------------------------------------------------------------
# Подключение к VM с 1С (sshfs)
# -----------------------------------------------------------------------------
# IP-адрес Hyper-V VM с сервером 1С
ONEC_VM_IP=192.168.250.2
# SSH-пользователь на VM
ONEC_VM_USER=sandbox
# Абсолютный путь к SSH-ключу на хосте (передаётся через Docker secrets)
ONEC_SSH_KEY=/path/to/id_ed25519

# Удалённый путь к srvinfo (журналы регистрации 1С)
ONEC_SRVINFO_REMOTE=/opt/onec-export/srvinfo
# Удалённый путь к технологическому журналу
ONEC_TECHLOG_REMOTE=/opt/onec-export/logs

# Удалённый каталог с logcfg.xml, который указан в ConfLocation на сервере 1С
ONEC_TECHLOG_CONFIG_REMOTE=/opt/1cv8/conf

# Путь сохранения логов ТЖ внутри VM (используется при генерации logcfg.xml)
TECHLOG_DIRS=/var/log/techlog

# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------
CLICKHOUSE_DB=logs
CLICKHOUSE_PORT=9000
# Сервисный пользователь (создаётся автоматически при первом запуске)
CLICKHOUSE_USER=logchecker
# ОБЯЗАТЕЛЬНО сменить на проде!
CLICKHOUSE_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Парсер
# -----------------------------------------------------------------------------
# Временная зона. ClickHouse хранит в UTC, парсер конвертирует из локального.
TZ=Europe/Moscow

# Параллельные воркеры на один файл журнала
MAX_WORKERS=4
# Глобальный лимит воркеров (<=0 — без лимита)
MAX_GLOBAL_WORKERS=0
# Размер батча записей перед вставкой в ClickHouse
BATCH_SIZE=5000
# Максимальное время ожидания перед сбросом батча (мс)
BATCH_FLUSH_TIMEOUT=1000
# Дедупликация по хешу (замедляет запись ~2x)
ENABLE_DEDUPLICATION=false
# Период хранения данных (дней)
LOG_RETENTION_DAYS=30
# Режим только чтения (без записи в ClickHouse)
READ_ONLY=false
# Уровень логирования: debug, info, warn, error
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# MCP-сервер
# -----------------------------------------------------------------------------
MCP_PORT=8080

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=admin
